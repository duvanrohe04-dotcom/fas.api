PROJECT_NAME="Cafeteria API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
SECRET_KEY="una-clave-secreta-muy-segura-cambiar-en-produccion"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
DATABASE_URL="sqlite:///./cafeteria.db"
# Para PostgreSQL usa:
# DATABASE_URL="postgresql://user:password@localhost:5432/cafeteria"

# Dominio(s) del frontend permitidos por CORS, separados por comas.
# En producción: CORS_ORIGINS="https://cafe.midominio.com"
CORS_ORIGINS="*"

# Administrador inicial. Solo se crea si la tabla de usuarios está vacía.
# Ignorado si ya existe algún usuario.
ADMIN_EMAIL="admin@cafeteria.com"
ADMIN_PASSWORD="cambia-esta-clave-en-produccion"
ADMIN_FULL_NAME="Administrador"

# Puerto publicado en el host por Docker (el interno sigue siendo 8000).
# Cámbialo si el puerto ya está ocupado en la máquina.
API_PORT=8010
