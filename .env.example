# --- Aplicación ---
APP_NAME="Cafetería API"
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# --- Base de datos ---
# SQLite en desarrollo:
DATABASE_URL=sqlite:///./cafeteria.db
# PostgreSQL en producción (descomentar):
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/cafeteria
DATABASE_ECHO=false

# --- Seguridad ---
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=cambia-esta-clave-en-produccion-por-favor-1234567890
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

# --- Paginación ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Panel web ---
TEMPLATES_DIR=templates
STATIC_DIR=static
COOKIE_NAME=cafeteria_session
SESSION_COOKIE_SECURE=false
